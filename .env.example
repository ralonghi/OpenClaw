# Copie este arquivo para .env e preencha as chaves que for usar.
# Nunca commite o .env.

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_TZ=America/Sao_Paulo
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1
OPENCLAW_DISABLE_BONJOUR=1

# Token para abrir a Control UI em http://127.0.0.1:18789/
# Gere um valor com: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Pelo menos uma chave de provedor (descomente a que usar)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
